datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("SELF_SERVE")
  crm       String   @default("NONE")
  createdAt DateTime @default(now())

  users           User[]
  domains         Domain[]
  sequences       Sequence[]
  icps            ICP[]
  podAssignments  PodAssignment[]
  circuitBreakerEvents CircuitBreakerEvent[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  isAdmin   Boolean  @default(false)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("users")
}

model Domain {
  id          String   @id @default(uuid())
  domain      String
  spfStatus  String   @default("pending")
  dkimStatus String   @default("pending")
  dmarcStatus String  @default("pending")
  warmupDay  Int      @default(0)
  status      String   @default("WARMING")
  createdAt  DateTime @default(now())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("domains")
}

model Sequence {
  id        String   @id @default(uuid())
  name      String
  version   Int      @default(1)
  status    String   @default("DRAFT")
  spec      String?  // JSON stored as String
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  steps     Step[]
  enrollments Enrollment[]

  @@index([tenantId])
  @@map("sequences")
}

model Step {
  id          String   @id @default(uuid())
  idx         Int
  channel     String
  waitDays    Int
  bodyTemplate String?
  sequenceId String
  sequence    Sequence @relation(fields: [sequenceId], references: [id])

  @@index([sequenceId])
  @@map("steps")
}

model Enrollment {
  id            String   @id @default(uuid())
  contactId     String
  contactEmail  String
  status        String   @default("ACTIVE")
  enrolledAt    DateTime @default(now())
  sequenceId   String
  sequence     Sequence @relation(fields: [sequenceId], references: [id])
  messages     Message[]

  @@index([sequenceId])
  @@map("enrollments")
}

model Message {
  id          String   @id @default(uuid())
  channel     String
  status      String   @default("QUEUED")
  sentAt      DateTime?
  enrollmentId String
  enrollment  Enrollment @relation(fields: [enrollmentId], references: [id])
  stepId      String
  step        Step      @relation(fields: [stepId], references: [id])
  replies     Reply[]

  @@index([enrollmentId])
  @@index([stepId])
  @@map("messages")
}

model Reply {
  id          String   @id @default(uuid())
  body        String
  bucket      String
  receivedAt  DateTime @default(now())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@map("replies")
}

model ICP {
  id            String   @id @default(uuid())
  source        String
  contactCount  Int
  importedAt   DateTime @default(now())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("icps")
}

model PodAssignment {
  id              String   @id @default(uuid())
  operatorUserId String?
  operatorName    String?
  assignedAt      DateTime @default(now())
  status          String   @default("ACTIVE")
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  interventions   PodIntervention[]

  @@index([tenantId])
  @@index([status])
  @@map("pod_assignments")
}

model CircuitBreakerEvent {
  id          String   @id @default(uuid())
  tenantId    String
  domainId    String?
  channel     String
  trigger     String
  threshold   Float
  actualValue Float
  action      String
  resumeAt    DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([domainId])
  @@index([channel])
  @@index([createdAt])
  @@map("circuit_breaker_events")
}

model PodIntervention {
  id              String   @id @default(uuid())
  podAssignmentId String
  podAssignment   PodAssignment @relation(fields: [podAssignmentId], references: [id])
  domainId        String?
  sequenceId      String?
  type            String
  priority        String   @default("NORMAL")
  status          String   @default("OPEN")
  notes           String?
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  @@index([podAssignmentId])
  @@index([status])
  @@index([priority])
  @@map("pod_interventions")
}
