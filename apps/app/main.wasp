app saltrun {
  wasp: {
    version: "0.16.0"
  },
  title: "Saltrun - Outbound Sales Machines",
  head: [
    "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap\" />",
    "<link rel=\"icon\" href=\"/favicon.ico\" />",
  ],
  auth: {
    userEntity: User,
    methods: {
      email: {
        fromField: {
          name: "Saltrun",
          email: "hello@saltrun.com"
        },
        userSignupFields: import { userSignupFields } from "@src/auth/email/userSignupFields",
      },
    },
    onAuthSucceededRedirectTo: "/",
    onAuthFailedRedirectTo: "/login",
  },
  emailSender: {
    provider: SMTP
  },
  client: {
    rootComponent: import { App } from "@src/App.tsx",
  }
}

// #region Entities
entity Tenant {
  id: UUID @id @default(uuid()),
  name: String,
  plan: Enum { SELF_SERVE, MANAGED } @default(SELF_SERVE),
  crm: Enum { SALESFORCE, HUBSPOT, NONE } @default(NONE),
  createdAt: DateTime @default(now()),
  users: [User],
  domains: [Domain],
  sequences: [Sequence],
  icps: [ICP],
  podAssignments: [PodAssignment]
}

entity User {
  id: UUID @id @default(uuid()),
  email: String @unique,
  isAdmin: Boolean @default(false),
  tenant: Tenant @relation(link: Tenant.id),
  tenantId: UUID
}

entity Domain {
  id: UUID @id @default(uuid()),
  domain: String,
  spfStatus: String @default("pending"),
  dkimStatus: String @default("pending"),
  dmarcStatus: String @default("pending"),
  warmupDay: Int @default(0),
  status: Enum { WARMUP_READY, WARMING, HEALTHY, PAUSED, EXPIRING } @default(WARMING),
  createdAt: DateTime @default(now()),
  tenant: Tenant @relation(link: Tenant.id),
  tenantId: UUID
}

entity Sequence {
  id: UUID @id @default(uuid()),
  name: String,
  version: Int @default(1),
  status: Enum { DRAFT, ACTIVE, PAUSED } @default(DRAFT),
  spec: JSON,
  tenant: Tenant @relation(link: Tenant.id),
  tenantId: UUID,
  steps: [Step],
  enrollments: [Enrollment]
}

entity Step {
  id: UUID @id @default(uuid()),
  idx: Int,
  channel: Enum { EMAIL, LINKEDIN, VOICE },
  waitDays: Int,
  bodyTemplate: String,
  sequence: Sequence @relation(link: Sequence.id),
  sequenceId: UUID
}

entity Enrollment {
  id: UUID @id @default(uuid()),
  contactId: String,
  contactEmail: String,
  contactLinkedInUrl: String?,
  contactPhone: String?,
  contactTimezone: String? @default("America/New_York"),
  status: Enum { ACTIVE, PAUSED, COMPLETED, OPTED_OUT, REPLIED } @default(ACTIVE),
  enrolledAt: DateTime @default(now()),
  sequence: Sequence @relation(link: Sequence.id),
  sequenceId: UUID,
  messages: [Message]
}

entity Message {
  id: UUID @id @default(uuid()),
  channel: String,
  status: Enum { QUEUED, SENT, DELIVERED, BOUNCED, OPENED, CLICKED } @default(QUEUED),
  sentAt: DateTime?,
  enrollment: Enrollment @relation(link: Enrollment.id),
  enrollmentId: UUID,
  step: Step @relation(link: Step.id),
  stepId: UUID,
  replies: [Reply]
}

entity Reply {
  id: UUID @id @default(uuid()),
  body: String,
  bucket: Enum { HOT, WARM, COLD, AUTO_REPLY, OOF },
  receivedAt: DateTime @default(now()),
  message: Message @relation(link: Message.id),
  messageId: UUID
}

entity ICP {
  id: UUID @id @default(uuid()),
  source: String,
  contactCount: Int,
  importedAt: DateTime @default(now()),
  tenant: Tenant @relation(link: Tenant.id),
  tenantId: UUID
}

entity PodAssignment {
  id: UUID @id @default(uuid()),
  assignedAt: DateTime @default(now()),
  tenant: Tenant @relation(link: Tenant.id),
  tenantId: UUID
}
// #endregion

// #region Auth Routes
route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import { LoginPage } from "@src/auth/email/LoginPage.tsx"
}

route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import { SignupPage } from "@src/auth/email/SignupPage.tsx"
}

route EmailVerificationRoute { path: "/email-verification", to: EmailVerificationPage }
page EmailVerificationPage {
  component: import { EmailVerificationPage } from "@src/auth/email/EmailVerificationPage.tsx"
}

route RequestPasswordResetRoute { path: "/request-password-reset", to: RequestPasswordResetPage }
page RequestPasswordResetPage {
  component: import { RequestPasswordResetPage } from "@src/auth/email/RequestPasswordResetPage.tsx"
}

route PasswordResetRoute { path: "/password-reset", to: PasswordResetPage }
page PasswordResetPage {
  component: import { PasswordResetPage } from "@src/auth/email/PasswordResetPage.tsx"
}
// #endregion

// #region App Routes
route DashboardRoute { path: "/", to: DashboardPage }
page DashboardPage {
  authRequired: true,
  component: import { DashboardPage } from "@src/pages/DashboardPage.tsx"
}

route DomainsRoute { path: "/domains", to: DomainsPage }
page DomainsPage {
  authRequired: true,
  component: import { DomainsPage } from "@src/pages/DomainsPage.tsx"
}

route SequencesRoute { path: "/sequences", to: SequencesPage }
page SequencesPage {
  authRequired: true,
  component: import { SequencesPage } from "@src/pages/SequencesPage.tsx"
}

route SequenceBuilderRoute { path: "/sequences/builder", to: SequenceBuilderPage }
page SequenceBuilderPage {
  authRequired: true,
  component: import { SequenceBuilderPage } from "@src/pages/SequenceBuilderPage.tsx"
}

route PodQueueRoute { path: "/pod-queue", to: PodQueuePage }
page PodQueuePage {
  authRequired: true,
  component: import { PodQueuePage } from "@src/pages/PodQueuePage.tsx"
}
// #endregion

// #region Queries
query getTenant {
  fn: import { getTenant } from "@src/server/src/queries",
  entities: [Tenant, User, Domain]
}

query getDomains {
  fn: import { getDomains } from "@src/server/src/queries",
  entities: [Domain]
}

query getSequences {
  fn: import { getSequences } from "@src/server/src/queries",
  entities: [Sequence, Step]
}

query getReplies {
  fn: import { getReplies } from "@src/server/src/queries",
  entities: [Reply, Message, Enrollment, Sequence]
}
// #endregion

// #region API Routes
api triageWebhook {
  fn: import { triageReply } from "@src/server/src/triageApi",
  entities: [Message, Reply, Enrollment],
  httpRoute: (POST, "/api/internal/replies/triage"),
  auth: false
}

api circuitAction {
  fn: import { circuitAction } from "@src/server/src/circuitApi",
  entities: [Domain, Tenant],
  httpRoute: (POST, "/api/internal/circuit/email/:domain"),
  auth: false
}

api circuitStatus {
  fn: import { circuitStatus } from "@src/server/src/circuitApi",
  entities: [Domain, Tenant],
  httpRoute: (GET, "/api/internal/circuit/email/:domain"),
  auth: false
}

api getPodQueue {
  fn: import { getPodQueue } from "@src/server/src/podQueueApi",
  entities: [PodAssignment, Tenant],
  httpRoute: (GET, "/api/pod/queue"),
  auth: true
}

api getPodAssignments {
  fn: import { getPodAssignments } from "@src/server/src/podQueueApi",
  entities: [PodAssignment, Tenant],
  httpRoute: (GET, "/api/pod/assignments"),
  auth: true
}

api getPodOperators {
  fn: import { getPodOperators } from "@src/server/src/podQueueApi",
  entities: [PodAssignment],
  httpRoute: (GET, "/api/pod/operators"),
  auth: true
}

api createPodIntervention {
  fn: import { createPodIntervention } from "@src/server/src/podQueueApi",
  entities: [PodAssignment, Tenant],
  httpRoute: (POST, "/api/pod/interventions"),
  auth: true
}

api updatePodIntervention {
  fn: import { updatePodIntervention } from "@src/server/src/podQueueApi",
  entities: [PodAssignment],
  httpRoute: (PATCH, "/api/pod/interventions/:id"),
  auth: true
}
// #endregion

// #region Actions
action createDomain {
  fn: import { createDomain } from "@src/server/src/actions",
  entities: [Domain, Tenant, User]
}

action updateDomain {
  fn: import { updateDomain } from "@src/server/src/actions",
  entities: [Domain]
}

action createSequence {
  fn: import { createSequence } from "@src/server/src/actions",
  entities: [Sequence, Step, Tenant, User]
}

action updateSequence {
  fn: import { updateSequence } from "@src/server/src/actions",
  entities: [Sequence, Step, Tenant, User]
}

action launchSequence {
  fn: import { launchSequence } from "@src/server/src/actions",
  entities: [Sequence, Step, Tenant, User]
}

action pauseSequence {
  fn: import { pauseSequence } from "@src/server/src/actions",
  entities: [Sequence, Step, Tenant, User]
}

action triageReply {
  fn: import { triageReplyAction } from "@src/server/src/actions",
  entities: [Message, Reply, Enrollment, Tenant]
}
// #endregion
