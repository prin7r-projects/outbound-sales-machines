# Public app URL — used in NOWPayments redirect + IPN callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://outbound-sales-machines.prin7r.com

# NOWPayments — hosted invoice (USDT/USDC) + fiat-partner card on-ramp.
# Source: payments-prototypes/.env.example. Never commit live values.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# Plisio (backup, no-KYC stablecoin). Wave 2 stub — not currently invoked from the landing CTAs.
PLISIO_API_KEY=

# Reown / WalletConnect — direct-wallet fallback (Wave 2 stub).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Merchant settlement wallets (used as documentation reference only).
MERCHANT_USDT_TRC20_ADDRESS=
MERCHANT_USDT_ERC20_ADDRESS=
MERCHANT_USDC_ERC20_ADDRESS=
MERCHANT_USDC_POLYGON_ADDRESS=
MERCHANT_USDT_BSC_ADDRESS=
